        "$type": "duration",
        "$value": {
          "value": 580,
          "unit": "ms"
        },
        "$description": "--motion-xslow"
      },
      "tap": {
        "$type": "duration",
        "$value": {
          "value": 80,
          "unit": "ms"
        },
        "$description": "--motion-tap"
      },
      "appear": {
        "$type": "duration",
        "$value": {
          "value": 200,
          "unit": "ms"
        },
        "$description": "--motion-appear"
      },
      "shift": {
        "$type": "duration",
        "$value": {
          "value": 260,
          "unit": "ms"
        },
        "$description": "--motion-shift"
      },
      "reveal": {
        "$type": "duration",
        "$value": {
          "value": 400,
          "unit": "ms"
        },
        "$description": "--motion-reveal"
      },
      "settle": {
        "$type": "duration",
        "$value": {
          "value": 600,
          "unit": "ms"
        },
        "$description": "--motion-settle"
      },
      "dismiss": {
        "$type": "duration",
        "$value": {
          "value": 180,
          "unit": "ms"
        },
        "$description": "--motion-dismiss"
      }
    },
    "easing": {
      "out": {
        "$type": "cubicBezier",
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "--ease-out"
      },
      "inOut": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          0.2,
          1
        ],
        "$description": "--ease-in-out"
      },
      "in": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "--ease-in"
      },
      "spring": {
        "$type": "cubicBezier",
        "$value": [
          0.34,
          1.56,
          0.64,
          1
        ],
        "$description": "--ease-spring"
      },
      "springSnappy": {
        "$type": "cubicBezier",
        "$value": [
          0.34,
          1.56,
          0.64,
          1
        ],
        "$description": "--ease-spring-snappy"
      },
      "springGentle": {
        "$type": "cubicBezier",
        "$value": [
          0.22,
          1,
          0.36,
          1
        ],
        "$description": "--ease-spring-gentle"
      },
      "decel": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0.2,
          1
        ],
        "$description": "--ease-decel"
      },
      "accel": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "--ease-accel"
      },
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          0.2,
          1
        ],
        "$description": "--ease-standard"
      }
    }
  },
