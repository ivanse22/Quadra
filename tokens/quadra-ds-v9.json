          "value": 1,
          "unit": "px"
        },
        "$description": "Grosor por defecto para bordes/strokes alineados con CSS (sin token explícito en tokens.css)."
      }
    }
  },
  "color": {
    "reference": {
      "fin": {
        "incomeDark": {
          "$type": "color",
          "$value": "#4ADE80",
          "$description": "Alias :root --fin-income-dark (referencia para UI en fondos oscuros)."
        },
