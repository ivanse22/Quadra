    "size": {
      "xs": {
        "$type": "dimension",
        "$value": {
          "value": 11,
          "unit": "px"
        },
        "$description": "Referencia Figma (max del clamp). CSS --t-xs: clamp(.625rem,.60rem+.13vw,.6875rem)"
      },
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 13,
          "unit": "px"
        },
        "$description": "CSS --t-sm: clamp(.75rem,.72rem+.15vw,.8125rem)"
      },
      "base": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$description": "CSS --t-base: clamp(.8125rem,.78rem+.16vw,.875rem)"
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "CSS --t-md: clamp(.9375rem,.90rem+.19vw,1rem)"
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 19,
          "unit": "px"
        },
        "$description": "CSS --t-lg: clamp(1.0625rem,1rem+.31vw,1.1875rem)"
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 28,
          "unit": "px"
        },
